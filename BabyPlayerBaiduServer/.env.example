# 用途：BabyPlayer 百度授权服务的环境变量模板。
# 主要功能：列出 MySQL、百度应用、公开回调和密钥配置。
# 最近修改：【MODIFIED】Phase 5 确保 Secret 与令牌仅存服务器环境。
BABYPLAYER_DB_HOST=127.0.0.1
BABYPLAYER_DB_PORT=3306
BABYPLAYER_DB_USER=babyplayer
BABYPLAYER_DB_PASSWORD=replace-on-server
BABYPLAYER_DB_NAME=babyplayer
# 【MODIFIED】App ID 只作控制台应用标识；OAuth client_id 必须使用 App Key。
BABYPLAYER_BAIDU_APP_ID=replace-with-numeric-app-id
BABYPLAYER_BAIDU_CLIENT_ID=replace-after-application
BABYPLAYER_BAIDU_CLIENT_SECRET=replace-after-application
BABYPLAYER_BAIDU_REDIRECT_URI=https://babyplayer-api.wisteriasoftware.uk/v1/oauth/callback
BABYPLAYER_PUBLIC_API_ORIGIN=https://babyplayer-api.wisteriasoftware.uk
BABYPLAYER_PHONE_ORIGIN=https://wisteriasoftware.uk
BABYPLAYER_TOKEN_FERNET_KEY=generate-with-Fernet.generate_key
