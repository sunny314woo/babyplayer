# The service remains healthy but ASR is disabled while any XX placeholder remains.
BABYPLAYER_API_TOKEN=XX_BABYPLAYER_API_TOKEN
TENCENT_ASR_APP_ID=XX_APP_ID
TENCENT_ASR_SECRET_ID=XX_SECRET_ID
TENCENT_ASR_SECRET_KEY=XX_SECRET_KEY

# D3 evidence reconciliation. Timestamps remain owned by Tencent ASR.
DEEPSEEK_API_KEY=XX_DEEPSEEK_API_KEY
DEEPSEEK_ENDPOINT=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-v4-flash
LYRICS_RECONCILIATION_VERSION=babyplayer-lyrics-d3-v1
LYRICS_WEB_SEARCH_ENABLED=true
LYRICS_WEB_SEARCH_TIMEOUT_SECONDS=8
LYRICS_WEB_SEARCH_MAX_RESULTS=3

TENCENT_ASR_ENDPOINT=https://asr.cloud.tencent.com
TENCENT_ASR_ENGINE_TYPE=16k_en
# Absolute account-wide ceiling: 5 hours per calendar month.
TENCENT_ASR_MONTHLY_LIMIT_SECONDS=18000
# BabyPlayer uploads at most the first two minutes of the song segment.
TENCENT_ASR_MAX_AUDIO_SECONDS=120
TENCENT_ASR_MAX_AUDIO_BYTES=12582912
TENCENT_ASR_TIMEOUT_SECONDS=30
TENCENT_ASR_MAX_CONCURRENCY=2
TENCENT_ASR_REQUESTS_PER_MINUTE=3
ASR_ANALYSIS_VERSION=babyplayer-asr-v1

# Mac local quality path. Production stays disabled unless explicitly enabled.
LOCAL_VOCAL_SEPARATION_ENABLED=false
LOCAL_VOCAL_SEPARATION_MODEL=Kim_Vocal_2.onnx
LOCAL_VOCAL_SEPARATION_MODEL_DIRECTORY=/var/lib/babyplayer-asr/audio-separator-models
LOCAL_VOCAL_SEPARATION_VERSION=python-audio-separator-0.44.5-kim-vocal-2-v1
# Only stop before Tencent when both conservative conditions are below threshold.
LOCAL_MINIMUM_VOCAL_COVERAGE=0.03
LOCAL_MINIMUM_VOCAL_MEAN_PROBABILITY=0.05
LOCAL_VOICE_ACTIVITY_ENABLED=false
LOCAL_VOICE_ACTIVITY_THRESHOLD=0.15
LOCAL_VOICE_ACTIVITY_MINIMUM_SUSPICIOUS_WORDS=3
LOCAL_VOICE_ACTIVITY_MAXIMUM_LOW_COVERAGE=0.25

DATABASE_PATH=/var/lib/babyplayer-asr/babyplayer-asr.sqlite3
PRODUCT_ENV=production
