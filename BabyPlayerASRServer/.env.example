# BabyPlayerASRServer/.env.example
# 【MODIFIED】2026-08-23：冻结版本 B 只保留 BabyPlayer 独立 Token 与腾讯 ASR 配置。
# 真实 Token/Secret 只能存在服务器 .env，不得提交到 Git。

BABYPLAYER_API_TOKEN=XX_BABYPLAYER_API_TOKEN
TENCENT_ASR_APP_ID=XX_APP_ID
TENCENT_ASR_SECRET_ID=XX_SECRET_ID
TENCENT_ASR_SECRET_KEY=XX_SECRET_KEY

TENCENT_ASR_ENDPOINT=https://asr.cloud.tencent.com
TENCENT_ASR_ENGINE_TYPE=16k_en
# Absolute account-wide ceiling: 5 hours per calendar month.
TENCENT_ASR_MONTHLY_LIMIT_SECONDS=18000
# BabyPlayer uploads at most the first two minutes of the song segment.
TENCENT_ASR_MAX_AUDIO_SECONDS=120
TENCENT_ASR_MAX_AUDIO_BYTES=12582912
TENCENT_ASR_TIMEOUT_SECONDS=30
TENCENT_ASR_MAX_CONCURRENCY=2
TENCENT_ASR_REQUESTS_PER_MINUTE=3
ASR_ANALYSIS_VERSION=babyplayer-asr-v1

DATABASE_PATH=/var/lib/babyplayer-asr/babyplayer-asr.sqlite3
PRODUCT_ENV=production
